# 채움(Chaeum) 백엔드 환경변수 예시
# 이 파일을 backend/.env 로 복사한 뒤 값을 채운다 (backend/app/.env 가 아니다 —
# app/main.py와 scripts/*.py 모두 backend/.env 만 읽는다). .env는 git에 올라가지 않는다.
# (셸에서 export로 넘겨도 동일하게 동작한다)

# --- 실제 공실 데이터 수집 (scripts/fetch_real_vacancies.py) ---
# 공공데이터포털 '일반 인증키(Decoding)'. 활용신청 건별로 키가 따로 발급된다.
# Encoding 키를 넣으면 SERVICE_KEY_IS_NOT_REGISTERED_ERROR가 난다.
SANGGA_API_SERVICE_KEY=
BLDRGST_API_SERVICE_KEY=
# 한 키로 두 API가 모두 열리는 계정이면 위 둘 대신 이 한 줄만 채워도 된다.
# DATA_GO_KR_SERVICE_KEY=

# --- 추천 사유 생성 + Space Vision (app/services/llm.py) ---
# Google AI Studio에서 발급하는 Gemini API 키. 없으면 에이전트 5는 템플릿 문구로,
# 에이전트 6은 FALLBACK_FEATURES 상수로 폴백한다.
GEMINI_API_KEY=

# 모델 오버라이드. 미지정 시 app/services/llm.py의 DEFAULT_MODEL을 쓴다.
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- 주변 유동인구 (app/services/sk_footfall.py) ---
# SK open API(openapi.sk.com) '유동인구' 상품의 앱 키. 없으면 시연용 가상 수치로 동작한다.
SK_OPENAPI_APP_KEY=

# 실행 모드 강제: sk_api | mock (미지정 시 키 유무로 자동 결정)
# SK_FOOTFALL_MODE=

# 엔드포인트 오버라이드. 계약 상품에 따라 경로가 달라서 환경변수로 뺐다.
# {area_code} {date} {lat} {lng} {radius} 를 치환한다.
# SK_FOOTFALL_BASE_URL=https://apis.openapi.sk.com
# 지역코드 기반 호출 (footfall_areas.json의 sk_area_code가 채워져 있을 때 사용)
# SK_FOOTFALL_AREA_PATH=/puzzle/pop/raw/hourly/districts/{area_code}
# 좌표 기반 호출을 지원하는 상품이면 이쪽을 지정한다 (지역코드가 없을 때 사용)
# SK_FOOTFALL_COORD_PATH=

# --- 로드뷰 / 주소→좌표 (scripts/geocode_buildings.py) ---
# Kakao Developers > 앱 키 > REST API 키.
# buildings.json에 lat/lng를 채우는 일회성 스크립트에서만 쓴다 (런타임 호출 없음).
KAKAO_REST_API_KEY=
