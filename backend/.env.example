# 채움(Chaeum) 백엔드 환경변수 예시
# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 git에 올라가지 않는다.
# (셸에서 export로 넘겨도 동일하게 동작한다)

# --- 공간 시각화 (app/services/space_render.py) ---
# HuggingFace Inference Providers 권한이 있는 fine-grained 토큰.
# 없으면 mock(색보정 미리보기) 모드로 동작한다.
HF_TOKEN=

# 실행 모드 강제: hf_api | local | mock (미지정 시 토큰 유무로 자동 결정)
# CHAEUM_RENDER_MODE=

# 모델 오버라이드 (선택)
# CHAEUM_HF_MODEL=black-forest-labs/FLUX.1-Kontext-dev
# CHAEUM_LOCAL_MODEL=diffusers/stable-diffusion-xl-1.0-inpainting-0.1

# --- 추천 사유 생성 (app/services/matching_agents.py) ---
# 없으면 템플릿 문구로 폴백한다.
ANTHROPIC_API_KEY=

# --- 주변 유동인구 (app/services/sk_footfall.py) ---
# SK open API(openapi.sk.com) '유동인구' 상품의 앱 키. 없으면 시연용 가상 수치로 동작한다.
SK_OPENAPI_APP_KEY=

# 실행 모드 강제: sk_api | mock (미지정 시 키 유무로 자동 결정)
# SK_FOOTFALL_MODE=

# 엔드포인트 오버라이드. 계약 상품에 따라 경로가 달라서 환경변수로 뺐다.
# {area_code} {date} {lat} {lng} {radius} 를 치환한다.
# SK_FOOTFALL_BASE_URL=https://apis.openapi.sk.com
# 지역코드 기반 호출 (footfall_areas.json의 sk_area_code가 채워져 있을 때 사용)
# SK_FOOTFALL_AREA_PATH=/puzzle/pop/raw/hourly/districts/{area_code}
# 좌표 기반 호출을 지원하는 상품이면 이쪽을 지정한다 (지역코드가 없을 때 사용)
# SK_FOOTFALL_COORD_PATH=
